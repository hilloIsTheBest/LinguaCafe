{
  "manifest_version": 3,
  "name": "LibreAudioChat Sidebar",
  "version": "0.1.0",
  "description": "Quick chat sidebar embedding LibreChat UI.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "LibreAudioChat"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3080/*",
    "https://*/"
  ]
}