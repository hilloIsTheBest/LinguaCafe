# Example environment overrides
ABS_URL=http://localhost:13378
ABS_TOKEN=REPLACE_WITH_YOUR_ABS_API_TOKEN
LIBRECHAT_URL=http://localhost:3080
# STT provider can be 'localai' (offline) or 'openai'
STT_PROVIDER=localai
STT_URL=http://localhost:8080/v1/audio/transcriptions
STT_MODEL=whisper-1
# RAG index URL to send transcript text (optional)
RAG_INDEX_URL=http://localhost:PORT/path/to/rag/ingest
RAG_API_KEY=YOUR_RAG_TOKEN
